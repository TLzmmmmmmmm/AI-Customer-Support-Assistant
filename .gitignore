# Virtual environments
.venv/
venv/
env/

# Python cache and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Local secrets and environment files
.env
.env.*
!.env.example

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local retrieval artifacts
knowledge/vector_records.jsonl
knowledge/.vector_records.jsonl.*.tmp

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Deployment
DEPLOYMENT.md

# Evaluation definitions are tracked; generated runs are local by default.
/eval/*
!/eval/baseline_v0.json
!/eval/baseline_v0_results.json
!/eval/rag_v1.json
!/eval/rag_v1_holdout.json
!/eval/rag_v1_authoring.json
!/eval/rag_v1_holdout_authoring.json
!/eval/rag_v1_manifest.json
!/eval/rag_v1_1_regression_manifest.json
!/eval/rag_v1_1_regression_authoring.json
!/eval/rag_v1_1_candidate_manifest.json
!/eval/rag_v1_1_holdout.json
!/eval/rag_v1_1_holdout_authoring.json
!/eval/trust_boundary_v1.json
!/eval/trust_boundary_v1_baseline.json
!/eval/user_prompt_injection_v1.json
!/eval/fixtures/
/eval/fixtures/*
!/eval/fixtures/rag_v1_attacks.json
!/eval/fixtures/rag_v1_holdout_attacks.json
!/eval/fixtures/rag_v1_1_holdout_attacks.json

# Keep only compact, owner-approved result summaries. Raw JSONL runs, locks,
# ledgers, probes, intermediate reviews, and future outputs remain ignored.
!/eval/results/
/eval/results/*
!/eval/results/baseline-v0-day6-review.json
!/eval/results/day7-step4-regression-review.json
!/eval/results/v1.1-holdout-summary.json
!/eval/results/v1.1-release-candidate-summary.json

# Documentation: track only current schemas, architecture, operator workflow,
# and one core acceptance report per completed phase. Local planning material,
# including docs/superpowers, remains ignored.
/docs/*
!/docs/chunk-schema-v1.md
!/docs/knowledge-schema-v1.md
!/docs/retrieval-schema-v1.md
!/docs/retrieval-architecture-v1.md
!/docs/rag-evaluation-v1.md
!/docs/day-5-alpha-acceptance.md
!/docs/day-6-step-7-v0-v1-comparison.md
!/docs/day-7-step-3-knowledge-update-workflow.md
!/docs/day-7-step-6-release-candidate-smoke.md
